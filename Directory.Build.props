<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Commit a packages.lock.json per project so CI restores with locked-mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- The recommended .NET analyzers, with any analyzer warning failing the build; code style
         rules that .editorconfig raises run in the build too. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- XML docs: shipped with the package, and needed for IDE0005 (unused usings) in the build.
         Missing comments (CS1591) are fine. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!-- Builds on GitHub Actions are deterministic, with Source Link paths. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
      >true</ContinuousIntegrationBuild
    >
  </PropertyGroup>
</Project>
